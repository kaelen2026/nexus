{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "env": ["DATABASE_URL", "REDIS_URL"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
